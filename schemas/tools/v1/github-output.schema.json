{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/tools/v1/github-output.schema.json",
  "title": "GitHub Tool Output",
  "type": "object",
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "providerRequestId", "classification", "retryable", "retryAfterMs", "outcome"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "providerRequestId": { "type": ["string", "null"] },
        "classification": { "enum": ["SUCCESS", "RATE_LIMIT", "PROVIDER", "TIMEOUT"] },
        "retryable": { "type": "boolean" },
        "retryAfterMs": { "type": ["integer", "null"], "minimum": 0 },
        "outcome": { "enum": ["SUCCEEDED", "FAILED", "TIMED_OUT"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "providerRequestId", "attemptCount", "attempts"],
      "properties": {
        "traceId": { "type": "string", "minLength": 1 },
        "providerRequestId": { "type": ["string", "null"] },
        "attemptCount": { "type": "integer", "minimum": 1 },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attempt" }
        }
      }
    },
    "policyFailureDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "gate", "retryable", "traceId"],
      "properties": {
        "category": { "const": "POLICY" },
        "gate": { "type": "string", "minLength": 1 },
        "retryable": { "const": false },
        "traceId": { "type": "string", "minLength": 1 }
      }
    },
    "providerFailureDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "retryable", "retryAfterMs", "attemptCount", "providerRequestId", "traceId", "attempts"],
      "properties": {
        "category": { "enum": ["RATE_LIMIT", "PROVIDER"] },
        "retryable": { "type": "boolean" },
        "retryAfterMs": { "type": ["integer", "null"], "minimum": 0 },
        "attemptCount": { "type": "integer", "minimum": 1 },
        "providerRequestId": { "type": ["string", "null"] },
        "traceId": { "type": "string", "minLength": 1 },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attempt" }
        }
      }
    },
    "timeoutFailureDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "retryable", "ambiguousPublication", "attemptCount", "providerRequestId", "traceId", "attempts"],
      "properties": {
        "category": { "const": "TIMEOUT" },
        "retryable": { "type": "boolean" },
        "ambiguousPublication": { "type": "boolean" },
        "attemptCount": { "type": "integer", "minimum": 1 },
        "providerRequestId": { "type": ["string", "null"] },
        "traceId": { "type": "string", "minLength": 1 },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attempt" }
        }
      }
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["operation", "repository", "issue", "metadata"],
      "properties": {
        "operation": { "const": "readIssue" },
        "repository": { "type": "string" },
        "issue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "title", "body", "state", "url", "author", "labels"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "title": { "type": "string" },
            "body": { "type": ["string", "null"] },
            "state": { "type": "string" },
            "url": { "type": "string", "minLength": 1 },
            "author": { "type": ["string", "null"] },
            "labels": { "type": "array", "items": { "type": "string" } }
          }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["operation", "repository", "pullRequest", "metadata"],
      "properties": {
        "operation": { "const": "createPullRequest" },
        "repository": { "type": "string" },
        "pullRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url", "head", "base"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "url": { "type": "string", "minLength": 1 },
            "head": { "type": "string", "minLength": 1 },
            "base": { "type": "string", "minLength": 1 }
          }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["operation", "repository", "failure"],
      "properties": {
        "operation": { "type": ["string", "null"] },
        "repository": { "type": ["string", "null"] },
        "failure": { "$ref": "#/$defs/policyFailureDetail" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["operation", "repository", "failure"],
      "properties": {
        "operation": { "type": "string" },
        "repository": { "type": "string" },
        "failure": { "$ref": "#/$defs/providerFailureDetail" }
      }
    },
    {
      "additionalProperties": false,
      "required": ["operation", "repository", "failure"],
      "properties": {
        "operation": { "type": "string" },
        "repository": { "type": "string" },
        "failure": { "$ref": "#/$defs/timeoutFailureDetail" }
      }
    }
  ]
}
