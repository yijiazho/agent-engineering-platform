{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/evaluationsuite.schema.json",
  "title": "EvaluationSuite Resource",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "aep.dev/v1alpha1"},
    "kind": {"const": "EvaluationSuite"},
    "metadata": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"}, "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}}, "additionalProperties": true},
    "spec": {"type": "object", "required": ["workflowRef", "evaluationRefs", "cases"], "properties": {
      "workflowRef": {"$ref": "#/$defs/workflowRef"},
      "evaluationRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evaluationRef"}},
      "metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "cases": {"type": "array", "minItems": 1, "items": {"oneOf": [
        {"type": "object", "required": ["id", "kind", "sourceRevision", "inputIdentity", "expectedOutcome"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"const": "fixture"}, "sourceRevision": {"type": "string", "minLength": 1}, "inputIdentity": {"type": "string", "minLength": 1}, "expectedOutcome": {"enum": ["PASS", "FAIL"]}, "evaluationSchemaVersion": {"type": "string"}, "metrics": {"type": "object"}, "buildSuccess": {"type": "boolean"}, "testSuccess": {"type": "boolean"}}, "additionalProperties": false},
        {"type": "object", "required": ["id", "kind", "workflowExecutionId"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"const": "historical"}, "workflowExecutionId": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      ]}}
    }, "additionalProperties": false}
  },
  "$defs": {
    "workflowRef": {"type": "object", "required": ["kind", "name", "version"], "properties": {"kind": {"const": "Workflow"}, "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "evaluationRef": {"type": "object", "required": ["kind", "name", "version"], "properties": {"kind": {"const": "Evaluation"}, "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
