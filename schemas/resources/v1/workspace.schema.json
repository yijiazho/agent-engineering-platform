{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/workspace.schema.json",
  "title": "Workspace Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./resource-definitions.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Workspace" },
    "metadata": { "$ref": "./resource-definitions.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "resourceDiscovery"],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "owner", "name", "defaultBranch"],
          "properties": {
            "provider": { "type": "string", "enum": ["github"] },
            "owner": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "defaultBranch": { "type": "string", "minLength": 1 }
          }
        },
        "resourceDiscovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root"],
          "properties": {
            "root": { "type": "string", "const": ".ai" }
          }
        },
        "defaultPolicies": { "$ref": "./resource-definitions.schema.json#/$defs/policyRefList" }
      }
    }
  }
}
