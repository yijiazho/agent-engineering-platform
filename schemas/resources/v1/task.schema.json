{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/task.schema.json",
  "title": "Task Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./resource-definitions.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Task" },
    "metadata": { "$ref": "./resource-definitions.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "outputs"],
      "allOf": [
        {
          "if": { "required": ["agentRef"] },
          "then": { "required": ["inputContextTokenBudget"] }
        }
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "agentRef": { "$ref": "./resource-definitions.schema.json#/$defs/agentRef" },
        "inputs": { "$ref": "./resource-definitions.schema.json#/$defs/jsonSchema" },
        "outputs": { "$ref": "./resource-definitions.schema.json#/$defs/jsonSchema" },
        "requiredContext": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optionalContext": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "inputContextTokenBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "planningPredicates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["predicate", "postcondition", "selectionReason"],
            "oneOf": [
              { "required": ["path"], "not": { "required": ["pathPrefix"] } },
              { "required": ["pathPrefix"], "not": { "required": ["path"] } }
            ],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "pathPrefix": { "type": "string", "minLength": 1 },
              "predicate": { "$ref": "#/$defs/filePredicate" },
              "postcondition": { "$ref": "#/$defs/filePredicate" },
              "selectionReason": { "type": "string", "minLength": 1 },
              "maxBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
              "maxPaths": { "type": "integer", "minimum": 1, "maximum": 200 }
            }
          }
        },
        "planningPredicateSource": {
          "type": "string",
          "enum": ["PRIOR_ISSUE_ANALYSIS"]
        },
        "planningEvidenceInspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxFileBytes", "maxTotalBytes", "statusFieldScanBytes"],
          "properties": {
            "maxFileBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
            "maxTotalBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
            "statusFieldScanBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
          }
        },
        "knowledgeBases": { "$ref": "./resource-definitions.schema.json#/$defs/knowledgeBaseRefList" },
        "evaluations": { "$ref": "./resource-definitions.schema.json#/$defs/evaluationRefList" },
        "policies": { "$ref": "./resource-definitions.schema.json#/$defs/policyRefList" },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gitToolRef", "githubToolRef", "timeoutMs"],
          "properties": {
            "gitToolRef": { "$ref": "./resource-definitions.schema.json#/$defs/toolRef" },
            "githubToolRef": { "$ref": "./resource-definitions.schema.json#/$defs/toolRef" },
            "timeoutMs": { "$ref": "./resource-definitions.schema.json#/$defs/durationMs" }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolRef", "image", "requiredExecutables", "commands", "workspaceMount", "resources", "timeoutMs"],
          "properties": {
            "toolRef": { "$ref": "./resource-definitions.schema.json#/$defs/toolRef" },
            "image": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+@sha256:[0-9a-f]{64}$"
            },
            "requiredExecutables": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["argv", "versionPattern"],
                "properties": {
                  "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "versionPattern": {"type": "string", "minLength": 1, "maxLength": 200}
                }
              }
            },
            "commands": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "argv"],
                "properties": {
                  "type": { "type": "string", "enum": ["build", "test"] },
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "required": ["type"],
                    "properties": { "type": { "const": "build" } }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "required": ["type"],
                    "properties": { "type": { "const": "test" } }
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            },
            "workspaceMount": {
              "type": "object",
              "additionalProperties": false,
              "required": ["containerPath", "readOnly"],
              "properties": {
                "containerPath": { "const": "/workspace" },
                "readOnly": { "const": false }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpuLimit", "memoryBytes"],
              "properties": {
                "cpuLimit": { "type": "number", "exclusiveMinimum": 0 },
                "memoryBytes": { "type": "integer", "minimum": 1 }
              }
            },
            "timeoutMs": { "$ref": "./resource-definitions.schema.json#/$defs/durationMs" }
          }
        }
      }
    }
  },
  "$defs": {
    "filePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["STATUS_EQUALS", "TEXT_PRESENT", "TEXT_ABSENT", "UNSUPPORTED_SEMANTIC"] },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
