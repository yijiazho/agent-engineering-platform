{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/knowledgebase.schema.json",
  "title": "KnowledgeBase Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./resource-definitions.schema.json#/$defs/apiVersion" },
    "kind": { "const": "KnowledgeBase" },
    "metadata": { "$ref": "./resource-definitions.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "indexing"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "type": "string", "enum": ["repository", "docs", "adr", "runbook"] },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        },
        "indexing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": { "type": "string", "enum": ["file-inventory", "documentation", "ast", "hybrid"] }
          }
        },
        "refreshPolicy": { "type": "string", "enum": ["on-change", "scheduled", "manual"] },
        "visibility": { "type": "string", "enum": ["workspace"] }
      }
    }
  }
}
