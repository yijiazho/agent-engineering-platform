{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/policy.schema.json",
  "title": "Policy Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./resource-definitions.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Policy" },
    "metadata": { "$ref": "./resource-definitions.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rules"],
      "properties": {
        "type": { "type": "string", "enum": ["pre-execution-capability", "publication", "approval"] },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect"],
            "properties": {
              "effect": { "type": "string", "enum": ["allow", "deny", "require-approval"] },
              "capabilities": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "conditions": { "$ref": "./resource-definitions.schema.json#/$defs/jsonSchema" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "pre-execution-capability" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "rules": {
                "items": {
                  "required": ["capabilities"],
                  "properties": {
                    "capabilities": { "minItems": 1 }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
