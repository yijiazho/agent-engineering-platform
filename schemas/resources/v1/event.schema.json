{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/event.schema.json",
  "title": "Event Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./resource-definitions.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Event" },
    "metadata": { "$ref": "./resource-definitions.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "type", "schema"],
      "properties": {
        "source": { "type": "string", "enum": ["github"] },
        "type": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$" },
        "schema": { "$ref": "./resource-definitions.schema.json#/$defs/jsonSchema" }
      }
    }
  }
}
