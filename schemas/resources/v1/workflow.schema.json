{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/workflow.schema.json",
  "title": "Workflow Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./resource-definitions.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Workflow" },
    "metadata": { "$ref": "./resource-definitions.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggers", "tasks"],
      "properties": {
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eventRef"],
            "properties": {
              "eventRef": { "$ref": "./resource-definitions.schema.json#/$defs/eventRef" }
            }
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskRef"],
            "properties": {
              "taskRef": { "$ref": "./resource-definitions.schema.json#/$defs/taskRef" },
              "dependsOn": { "$ref": "./resource-definitions.schema.json#/$defs/taskRefList" }
            }
          }
        },
        "policies": { "$ref": "./resource-definitions.schema.json#/$defs/policyRefList" },
        "parallelism": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
