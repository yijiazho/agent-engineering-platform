{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/agent.schema.json",
  "title": "Agent Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./resource-definitions.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Agent" },
    "metadata": { "$ref": "./resource-definitions.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptRef", "modelRef"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "promptRef": { "$ref": "./resource-definitions.schema.json#/$defs/promptRef" },
        "modelRef": { "$ref": "./resource-definitions.schema.json#/$defs/modelRef" },
        "toolRefs": { "$ref": "./resource-definitions.schema.json#/$defs/toolRefList" },
        "policyRefs": { "$ref": "./resource-definitions.schema.json#/$defs/policyRefList" },
        "outputSchema": { "$ref": "./resource-definitions.schema.json#/$defs/jsonSchema" }
      }
    }
  }
}
