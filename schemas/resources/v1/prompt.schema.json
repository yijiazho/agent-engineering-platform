{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aep.dev/schemas/resources/v1/prompt.schema.json",
  "title": "Prompt Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./resource-definitions.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Prompt" },
    "metadata": { "$ref": "./resource-definitions.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "formatting": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "output"],
            "properties": {
              "input": {},
              "output": {}
            }
          }
        }
      }
    }
  }
}
