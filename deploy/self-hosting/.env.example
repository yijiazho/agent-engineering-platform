AEP_IMAGE_REPOSITORY=ghcr.io/yijiazho/agent-engineering-platform
AEP_IMAGE_DIGEST=replace-with-64-lowercase-hex-characters
AEP_RESOURCE_REVISION=replace-with-40-lowercase-git-commit
# Use absolute host paths.
# Windows example: C:/aep/resources/agent-engineering-platform
# macOS/Linux example: /Users/<you>/aep/resources/agent-engineering-platform
AEP_RESOURCE_CHECKOUT=/absolute/path/to/resources/agent-engineering-platform
AEP_STATE_DIRECTORY=/absolute/path/to/state/agent-engineering-platform
# Docker Desktop on Windows and macOS also uses /var/run/docker.sock here.
AEP_DOCKER_SOCKET=/var/run/docker.sock
# Set true only when the pinned checkout was created with Windows Git
# core.autocrlf=true. macOS and Linux checkouts normally use false.
AEP_RESOURCE_GIT_AUTOCRLF=false
AEP_WEBHOOK_BIND_ADDRESS=127.0.0.1
AEP_GITHUB_APP_ID=replace-with-numeric-app-id
AEP_GITHUB_WEBHOOK_SECRET_FILE=./secrets/github-webhook-secret.txt
AEP_GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app-private-key.pem
AEP_OPENAI_API_KEY_FILE=./secrets/openai-api-key.txt
AEP_GITHUB_API_URL=https://api.github.com
AEP_OPENAI_API_URL=https://api.openai.com/v1
AEP_MODEL_WORKER_REPLICAS=1
AEP_GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576
