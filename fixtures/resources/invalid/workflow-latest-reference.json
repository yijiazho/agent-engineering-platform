{
  "apiVersion": "aep.dev/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "name": "issue-to-pr",
    "version": "1.0.0"
  },
  "spec": {
    "triggers": [
      {
        "eventRef": {
          "kind": "Event",
          "name": "github-issue-created",
          "version": "latest"
        }
      }
    ],
    "tasks": [
      {
        "taskRef": {
          "kind": "Task",
          "name": "analyze-issue",
          "version": "1.0.0"
        }
      }
    ]
  }
}
