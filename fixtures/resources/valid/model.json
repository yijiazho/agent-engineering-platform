{
  "apiVersion": "aep.dev/v1alpha1",
  "kind": "Model",
  "metadata": {
    "name": "default-reasoning",
    "version": "1.0.0"
  },
  "spec": {
    "provider": "openai",
    "model": "gpt-5",
    "parameters": {
      "temperature": 0.2
    },
    "tokenLimit": 32000,
    "pricing": {
      "inputPerMillionTokens": 1.25,
      "outputPerMillionTokens": 10,
      "currency": "USD",
      "source": "fixture-price-catalog",
      "effectiveAt": "2026-01-01T00:00:00Z"
    },
    "timeoutMs": 60000,
    "retryPolicy": {
      "maxAttempts": 2,
      "backoffMs": 1000
    },
    "rateLimitPolicy": {
      "requestsPerMinute": 2,
      "tokensPerMinute": 80000
    }
  }
}
