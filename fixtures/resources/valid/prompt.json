{
  "apiVersion": "aep.dev/v1alpha1",
  "kind": "Prompt",
  "metadata": {
    "name": "issue-analysis",
    "version": "1.0.0"
  },
  "spec": {
    "system": "Analyze the issue using only the provided ContextPackage.",
    "formatting": "Return structured JSON matching the task output schema.",
    "examples": [
      {
        "input": {
          "title": "Add tests"
        },
        "output": {
          "requestedChange": "Add tests.",
          "acceptanceCriteria": ["The requested tests pass."],
          "risks": ["Existing behavior may be underspecified."],
          "likelyRepositoryAreas": ["tests"]
        }
      }
    ]
  }
}
