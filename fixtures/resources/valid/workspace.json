{
  "apiVersion": "aep.dev/v1alpha1",
  "kind": "Workspace",
  "metadata": {
    "name": "default-workspace",
    "version": "1.0.0"
  },
  "spec": {
    "repository": {
      "provider": "github",
      "owner": "example",
      "name": "service",
      "defaultBranch": "main"
    },
    "resourceDiscovery": {
      "root": ".ai"
    },
    "defaultPolicies": [
      {
        "kind": "Policy",
        "name": "default-publication",
        "version": "1.0.0"
      }
    ]
  }
}
