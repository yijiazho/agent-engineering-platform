{
  "apiVersion": "aep.dev/v1alpha1",
  "kind": "Agent",
  "metadata": {
    "name": "issue-analyzer",
    "version": "1.0.0"
  },
  "spec": {
    "role": "Issue Analyzer",
    "promptRef": {
      "kind": "Prompt",
      "name": "issue-analysis",
      "version": "1.0.0"
    },
    "modelRef": {
      "kind": "Model",
      "name": "default-reasoning",
      "version": "1.0.0"
    },
    "toolRefs": [
      {
        "kind": "Tool",
        "name": "github-read-issue",
        "version": "1.0.0"
      }
    ],
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedChange",
        "acceptanceCriteria",
        "risks",
        "likelyRepositoryAreas"
      ],
      "properties": {
        "requestedChange": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "likelyRepositoryAreas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
