{
  "apiVersion": "aep.dev/v1alpha1",
  "kind": "Task",
  "metadata": {
    "name": "analyze-issue",
    "version": "1.0.0"
  },
  "spec": {
    "objective": "Classify a GitHub issue and extract acceptance criteria.",
    "agentRef": {
      "kind": "Agent",
      "name": "issue-analyzer",
      "version": "1.0.0"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedChange",
        "acceptanceCriteria",
        "risks",
        "likelyRepositoryAreas"
      ],
      "properties": {
        "requestedChange": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "likelyRepositoryAreas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requiredContext": ["issue", "candidate-files"],
    "optionalContext": ["repository-inventory", "documentation"],
    "inputContextTokenBudget": 32000,
    "evaluations": [
      {
        "kind": "Evaluation",
        "name": "issue-analysis-schema",
        "version": "1.0.0"
      }
    ]
  }
}
