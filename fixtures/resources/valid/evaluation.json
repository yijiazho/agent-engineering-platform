{
  "apiVersion": "aep.dev/v1alpha1",
  "kind": "Evaluation",
  "metadata": {
    "name": "issue-analysis-schema",
    "version": "1.0.0"
  },
  "spec": {
    "type": "schema",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedChange",
        "acceptanceCriteria",
        "risks",
        "likelyRepositoryAreas"
      ],
      "properties": {
        "requestedChange": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "likelyRepositoryAreas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "successCriteria": ["output validates against schema"]
  }
}
