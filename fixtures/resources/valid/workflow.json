{
  "apiVersion": "aep.dev/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "name": "issue-to-pr",
    "version": "1.0.0"
  },
  "spec": {
    "triggers": [
      {
        "eventRef": {
          "kind": "Event",
          "name": "github-issue-created",
          "version": "1.0.0"
        }
      }
    ],
    "tasks": [
      {
        "taskRef": {
          "kind": "Task",
          "name": "analyze-issue",
          "version": "1.0.0"
        }
      },
      {
        "taskRef": {
          "kind": "Task",
          "name": "generate-patch",
          "version": "1.0.0"
        },
        "dependsOn": [
          {
            "kind": "Task",
            "name": "analyze-issue",
            "version": "1.0.0"
          }
        ]
      }
    ],
    "budget": {
      "maxModelInvocations": 8,
      "maxInputTokens": 200000,
      "maxOutputTokens": 80000,
      "maxElapsedMs": 1800000,
      "maxCostUsd": 5
    },
    "parallelism": 1
  }
}
